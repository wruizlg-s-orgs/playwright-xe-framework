{
    "compilerOptions": {
        "target": "ES2022",

        "module": "ESNext",

        "moduleResolution": "bundler",

        "strict": true,

        "esModuleInterop": true,

        "skipLibCheck": true,

        "forceConsistentCasingInFileNames": true,

        "types": ["node", "@playwright/test"]
    },

    "include": [
        "tests",
        "pages",
        "fixtures",
        "helpers",
        "models",
        "services",
        "data",
        "schemas",
        "utils",
        "playwright.config.ts"
    ]
}
